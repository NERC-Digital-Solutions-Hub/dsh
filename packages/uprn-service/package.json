{
	"name": "@dsh/uprn-service",
	"version": "0.0.1",
	"scripts": {
		"dev": "pnpm --workspace-root run dev:uprn-service",
		"dev:linked": "pnpm run generate:content && vite dev",
		"dev:workspace": "pnpm run package:watch",
		"generate:content": "tsx scripts/generate-content-modules.ts",
		"build": "pnpm run generate:content && vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package",
		"package:watch": "svelte-kit sync && svelte-package --watch",
		"prepack": "pnpm run package && publint",
		"check": "pnpm run generate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "pnpm run generate:content && prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./content-build": {
			"types": "./dist/content-build/index.d.ts",
			"default": "./dist/content-build/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.48.5",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@dsh/common": "workspace:*",
		"@dsh/content": "workspace:*",
		"@internationalized/date": "^3.10.0",
		"@keenmate/svelte-treeview": "^4.8.0",
		"@lucide/svelte": "^0.544.0",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"dexie": "^4.2.1",
		"embla-carousel-svelte": "^8.6.0",
		"lottie-web": "^5.13.0",
		"minisearch": "^7.2.0",
		"mode-watcher": "^1.1.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"svelte-lightbox": "^1.1.7",
		"svelte-sonner": "^1.0.5",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@arcgis/core": "~5.0.0",
		"@arcgis/map-components": "~5.0.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"jsrepo": "^3.0.8",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"publint": "^0.3.15",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^7.2.2",
		"vitest": "^4.1.7"
	},
	"keywords": [
		"svelte"
	]
}